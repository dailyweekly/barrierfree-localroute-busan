# 배리어프리 로컬루트 부산 — 환경변수 예시
# 실제 .env.local 또는 Vercel Environment Variables 에만 값을 채워 사용
# .env 는 절대 커밋 금지 (.gitignore 등록됨)

# ----------------------------------------------------------
# 1) Anthropic Claude API (LLM 설명 생성용)
#    https://console.anthropic.com 에서 발급
# ----------------------------------------------------------
ANTHROPIC_API_KEY=

# 사용 모델 (기본: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ----------------------------------------------------------
# 2) 공공데이터포털 / odcloud 서비스키 (Decoded)
#    https://www.data.go.kr 활용신청 후 발급
#    부산교통공사·부산관광공사·부산광역시 데이터 동일 키 사용
# ----------------------------------------------------------
BUSAN_API_KEY=

# 갈맷길 코스 정보 별도 endpoint
GALMAEGIL_BASE_URL=https://apis.data.go.kr/6260000/BusanGalmaetGilService

# ----------------------------------------------------------
# 3) 운영 설정
# ----------------------------------------------------------
# 캐시 TTL(초) — 기본 86400 (1일)
DATA_CACHE_TTL=86400

# LLM 사용 여부 (false 면 결정론적 템플릿 설명만 사용)
LLM_ENABLED=true

# ----------------------------------------------------------
# 4) 미리보기 비밀번호 보호
# ----------------------------------------------------------
# 모든 페이지 진입 시 비밀번호 요구. 미설정 시 기본값 "test1234"
PREVIEW_PASSWORD=test1234
# 보호를 완전 비활성화하려면 true
PREVIEW_AUTH_DISABLED=false

# 사이트 배포 URL (sitemap/robots 생성용)
NEXT_PUBLIC_BASE_URL=https://barrierfree-localroute-busan.vercel.app
